# Copy to .env and fill in. Never commit .env.
#
# Sandbox keys: app.bachs.io → switch to Sandbox → Developer → API keys.
# Live keys move real money; use a separate file and a scoped key for tests.

BACHS_SECRET_KEY=sk_sandbox_paste_your_key_here
BACHS_WEBHOOK_SECRET=whsec_paste_your_signing_secret_here

# Optional: a product to use for catalog-based tests (product-less tests need nothing)
PRODUCT_ID=prod_paste_a_product_id_here

# Optional: webhook/redirect targets
BACHS_SUCCESS_URL=https://example.com/paid
BACHS_CANCEL_URL=https://example.com/cancelled
